# AI provider: gemini (free tier) or openai
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional OpenAI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Owner login (set a unique password, at least 12 characters)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional WordPress REST integration
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

NODE_ENV=development
